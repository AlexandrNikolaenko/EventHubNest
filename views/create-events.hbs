<div id="create-event-modal" class="active">
  <form id="create-event-form" class="modal">
    <label for="title" class="body1">Введите название *</label>
    <input id="title" autocomplete="off" name="title" placeholder="Title" />
    <span class="body1" id="title-error">Это поле обязательное</span>
    <label for="desc" class="body1">Введите описание *</label>
    <input
      id="desc"
      autocomplete="off"
      name="desc"
      placeholder="Description"
    />
    <span class="body1" id="desc-error">Это поле обязательное</span>
    <label for="date" class="body1">Введите дату проведения *</label>
    <input
      id="date"
      autocomplete="off"
      name="date"
      placeholder="Date"
      type="date"
    />
    <span class="body1" id="date-error">Это поле обязательное</span>
    <label for="place" class="body1"
      >Укажите место проведения проведения *</label
    >
    <input
      id="place"
      autocomplete="off"
      name="place"
      placeholder="Coordinates"
    />
    <span class="body1" id="place-error">Это поле обязательное</span>
    <label for="place" class="body1">Добавьте участников *</label>
    <div class="users-input">
      <input
        id="users"
        autocomplete="off"
        name="users"
        placeholder="User"
      />
      <ul id="users-list" class="hide"></ul>
      <ul id="users-active-list"></ul>
    </div>
    <button class="primary" type="submit">Создать</button>
    <button class="primary outline" id="close-cretor-modal">
      Отменить
    </button>
  </form>
</div>