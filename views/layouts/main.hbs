<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
  {{> header}}
  <script>
    window.__currentUser = {{#if currentUser}}{ id: {{currentUser.id}}, role: '{{currentUser.role}}' }{{else}}null{{/if}};
  </script>

  <main>
    {{{body}}}
  </main>
  {{> navbar}}

  {{> footer}}

  {{#if pageTemplates}}
    {{#each pageTemplates}}
        {{> (lookup this 'name') }}
    {{/each}}
  {{/if}}

  {{> scripts}}
  {{> scripts-page}}
</body>
</html>
