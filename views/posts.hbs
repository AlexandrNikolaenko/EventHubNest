<h2>Афиша мероприятий</h2>
<section id='filter-section'>
  <form id='search-form' class='search-events'>
    <input
      class='search__input'
      name='search'
      placeholder='Найти мероприятие по названию'
    />
    <button type='submit' class='search__button'>
      <img src='/images/search.svg' />
    </button>
  </form>
</section>
<section class='pagination-controls wrapper'>
  <button id='prev-page' class='secondary' disabled>Назад</button>
  <span id='current-page'>Страница 1</span>
  <button id='next-page' class='secondary'>Вперед</button>
  <label for='page-size'>На странице:</label>
  <select id='page-size'>
    <option value='5'>5</option>
    <option value='10' selected>10</option>
    <option value='20'>20</option>
    <option value='50'>50</option>
  </select>
</section>
<section id='poster-section'>
  <span id='query-error' class='h6 hide'></span>
  <div id='poster__empty' class='hide poster__empty'>
    <span class='h6'> Ничего не нашлось :( </span>
    <p class='body1'>
      У вас сейчас нет активных мероприятий, но вы можете создать новое
    </p>
  </div>
  <ul id='poster-list'>
    <li class='preloader'></li>
    <li class='preloader'></li>
    <li class='preloader'></li>
    <li class='preloader'></li>
    <li class='preloader'></li>
  </ul>
</section>