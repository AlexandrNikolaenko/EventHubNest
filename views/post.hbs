<section class='wrapper'>
  <div id='empty-state'>
    <span id='query-error' class='h6 hide'></span>
    <div id='poster__empty' class='hide poster__empty'>
      <span class='h6'> Ничего не нашлось :( </span>
      <p class='body1'>
        У вас сейчас нет активных мероприятий, но вы можете создать новое
      </p>
    </div>
    <div class='preloader'></div>
    <div class='preloader'></div>
  </div>
</section>

<section class='wrapper reviews-wrapper'>
  <h3>Отзывы о мероприятии</h3>

  <div class="reviews-content">
    <form id='review-form' class='review-form'>
      <label for='review-content' class='body1'>Ваш отзыв</label>
      <textarea id='review-content' name='content' rows='4' required></textarea>

      <label for='review-rating' class='body1'>Рейтинг (1-5)</label>
      <input id='review-rating' name='rating' type='number' min='1' max='5' />

      <button class='primary' type='submit'>Оставить отзыв</button>
    </form>

    <div id='reviews-list' class='reviews-list'></div>
  </div>
</section>