<section class='wrapper event-actions'>
  <div class='append-event'>
    <button class='create-event'>Создать событие</button>
    <button class='gen-event secondary'>Сгенерировать событие</button>
  </div>
  <form id='search-form' class='search-events'>
    <input
      class='search__input'
      name='search'
      placeholder='Найти мероприятие по названию'
    />
    <button type='submit' class='search__button'>
      <img src='/images/search.svg' />
    </button>
  </form>
  <div class='vision-info'>
    <button id='by-list' class='change-visible'>В виде списка</button>
    <button id='by-table' class='change-visible'>В виде таблицы</button>
  </div>
</section>
<section class='events wrapper'>
  <div id='events__empty' class='events__empty'>
    <span class='h6'> Ничего не нашлось :( </span>
    <p class='body1'>
      У вас сейчас нет активных мероприятий, но вы можете создать новое
    </p>
  </div>
  <ul id='events-list' class='hide events-list'></ul>
  <table id='events-table' class='hide events-table'>
    <thead>
      <tr>
        <th scope='col'>ID</th>
        <th scope='col'>Title</th>
        <th scope='col'>Description</th>
        <th scope='col'>Author</th>
        <th scope='col'>Date</th>
        <th scope='col'>Place</th>
      </tr>
    </thead>
    <tbody id='events-table-body'></tbody>
  </table>
</section>
<div id="create-event-modal">
  <form id="create-event-form" class="modal">
    <label for="title" class="body1">Введите название *</label>
    <input id="title" autocomplete="off" name="title" placeholder="Title" />
    <span class="body1" id="title-error">Это поле обязательное</span>
    <label for="desc" class="body1">Введите описание *</label>
    <input
      id="desc"
      autocomplete="off"
      name="desc"
      placeholder="Description"
    />
    <span class="body1" id="desc-error">Это поле обязательное</span>
    <label for="date" class="body1">Введите дату проведения *</label>
    <input
      id="date"
      autocomplete="off"
      name="date"
      placeholder="Date"
      type="date"
    />
    <span class="body1" id="date-error">Это поле обязательное</span>
    <label for="place" class="body1"
      >Укажите место проведения проведения *</label
    >
    <input
      id="place"
      autocomplete="off"
      name="place"
      placeholder="Coordinates"
    />
    <span class="body1" id="place-error">Это поле обязательное</span>
    <label for="place" class="body1">Добавьте участников *</label>
    <div class="users-input">
      <input
        id="users"
        autocomplete="off"
        name="users"
        placeholder="User"
      />
      <ul id="users-list" class="hide"></ul>
      <ul id="users-active-list"></ul>
    </div>
    <button class="primary" type="submit">Создать</button>
    <button class="primary outline" id="close-cretor-modal">
      Отменить
    </button>
  </form>
</div>
<div id="edit-event-modal">
  <form id="edit-event-form" class="modal">
    <label for="title" class="body1">Введите название *</label>
    <input
      id="edit-title"
      autocomplete="off"
      name="title"
      placeholder="Title"
    />
    <span class="body1" id="edit-title-error">Это поле обязательное</span>
    <label for="desc" class="body1">Введите описание *</label>
    <input
      id="edit-desc"
      autocomplete="off"
      name="desc"
      placeholder="Description"
    />
    <span class="body1" id="edit-desc-error">Это поле обязательное</span>
    <label for="date" class="body1">Введите дату проведения *</label>
    <input
      id="edit-date"
      autocomplete="off"
      name="date"
      placeholder="Date"
      type="date"
    />
    <span class="body1" id="edit-date-error">Это поле обязательное</span>
    <label for="place" class="body1"
      >Укажите место проведения проведения *</label
    >
    <input
      id="edit-place"
      autocomplete="off"
      name="place"
      placeholder="Coordinates"
    />
    <span class="body1" id="edit-place-error">Это поле обязательное</span>
    <button class="primary" type="submit">Сохранить</button>
    <button class="primary outline" id="close-edit-modal">Отменить</button>
  </form>
</div>
<div id="generate-event-modal">
  <form id="generate-event-form" class="modal">
    <label for="desc" class="body1">Введите описание</label>
    <input
      id="gen-desc"
      autocomplete="off"
      name="desc"
      placeholder="Description"
    />
    <label for="date" class="body1">Введите дату проведения</label>
    <input
      id="gen-date"
      autocomplete="off"
      name="date"
      placeholder="Date"
      type="date"
    />
    <button class="primary" type="submit">Сгенерировать</button>
    <button class="primary outline" id="close-generator-modal">
      Отменить
    </button>
  </form>
</div>