<header>
  <nav class='wrapper'>
    <a class='h6 logo' href='/'> Together </a>
    {{#unless isGuest}}
    <div class='header__nav-list'>
        {{> nav-link href='/' text='Главная'}}
        {{> nav-link href='/posts' text='Афиша'}}
        {{> nav-link href='/events' text='Создать событие'}}
        {{> nav-link href='/profile' text='Кабинет'}}
        {{> nav-link href='/about' text='О нас'}}
        {{#if currentUser}}
          <span class='body1 header__user'>{{currentUser.name}} · {{currentUser.role}}</span>
        {{/if}}
        <a href='/auth/login' class='header__button-enter'>
          <button class='secondary'>Войти</button>
        </a>
        <button class='logout error'>Выйти</button>
    </div>
    {{/unless}}
  </nav>
</header>
